{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "shell",
			"label": "Run Tests",
			"command": "uv",
			"args": [
				"run",
                "pytest",
                "tests"
			],
			"group": "test",
			"problemMatcher": [
				"$python"
			]
		},
		{
			"type": "shell",
			"label": "Lint (ruff)",
			"command": "uv",
			"args": [
                "run",
                "ruff",
				"check",
			],
			"group": "build",
			"problemMatcher": []
		},
        {
			"type": "shell",
			"label": "Format Check (ruff)",
			"command": "uv",
			"args": [
				"run",
                "ruff",
				"format",
                "--check",
			],
			"group": "build",
			"problemMatcher": []
		},
		{
			"type": "shell",
			"label": "Type Check (mypy)",
			"command": "uv",
			"args": [
				"run",
				"mypy",
				".",
			],
			"group": "build",
			"problemMatcher": []
		}
	]
}
